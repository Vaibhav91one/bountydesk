{
  "expo": {
    "name": "BountyDesk",
    "slug": "bountydesk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bountydesk",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "dev.bountydesk.mobile",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/icon.png"
      },
      "package": "dev.bountydesk.mobile",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0b0d",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "@clerk/expo",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "BountyDesk uses Face ID to confirm that you approve a verdict."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
