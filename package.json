{
  "name": "bounty-desk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:drift": "drizzle-kit generate && git diff --quiet --exit-code drizzle",
    "seed:target": "node --env-file-if-exists=.env.local --import tsx scripts/seed-target.ts",
    "seed:reports": "node --env-file-if-exists=.env.local --import tsx scripts/seed-reports.ts",
    "rotate:target": "node --env-file-if-exists=.env.local --import tsx scripts/rotate-target.ts",
    "enqueue:onboarding": "node --env-file-if-exists=.env.local --import tsx scripts/enqueue-onboarding.ts",
    "approve:onboarding": "node --env-file-if-exists=.env.local --import tsx scripts/approve-onboarding.ts",
    "quarantine:stale-target": "node --env-file-if-exists=.env.local --import tsx scripts/quarantine-stale-target.ts",
    "spike:daytona": "node --env-file-if-exists=.env.local --import tsx scripts/spike-daytona.ts",
    "probe:daytona-sandbox": "node --env-file-if-exists=.env.local --import tsx scripts/probe-daytona-sandbox.ts",
    "agent:apply": "node --env-file-if-exists=.env.local --import tsx scripts/apply-agent.ts",
    "skills:apply": "node --env-file-if-exists=.env.local --import tsx scripts/apply-skills.ts",
    "worker:jobs": "node --env-file-if-exists=.env.local --import tsx scripts/run-worker-once.ts",
    "worker:delivery": "node --env-file-if-exists=.env.local --import tsx scripts/run-delivery-once.ts",
    "worker:daemon": "node --env-file-if-exists=.env.local --import tsx scripts/run-worker-daemon.ts",
    "worker:healthcheck": "node --env-file-if-exists=.env.local scripts/worker-healthcheck.mjs",
    "trueforge:proxy": "node --env-file-if-exists=.env.local scripts/run-trueforge-proxy.mjs",
    "test": "node --env-file-if-exists=.env.local --import tsx --experimental-test-module-mocks --test \"lib/**/*.test.ts\" \"app/**/*.test.ts\" \"scripts/**/*.test.mjs\""
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.102.8",
    "@truefoundry/trueforge-sdk": "0.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "developer-icons": "^7.1.0",
    "drizzle-orm": "^0.45.2",
    "lenis": "^1.3.26",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "next": "16.3.3",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
