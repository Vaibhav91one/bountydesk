# BountyDesk environment template.
#
# Copy this file to .env.local and fill in your values. .env.local is gitignored;
# this file is the committed reference and holds placeholders only.


# ============================================================
# DATABASE  (Supabase)
# ============================================================
# Both strings come from the Supabase dashboard, under
# Project Settings > Database > Connection string.

# App runtime. Transaction pooler on the pooler host, port 6543 (safe for serverless).
# Transaction mode does not support prepared statements; disable them in the Drizzle driver.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Migrations only (drizzle-kit). Supabase recommends the direct connection where your network
# can reach it:
#   postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require
# That host is IPv6-only unless the project has the IPv4 add-on, so the session-mode pooler
# below is the IPv4 fallback: same pooler host, port 5432, no pgbouncer flag. Either works;
# use the direct one if it resolves for you.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"


# ============================================================
# SUPABASE CLIENT  (Supabase, optional)
# ============================================================
# Only if we add supabase-js for auth or storage. Drizzle does not need these,
# so they stay commented out for now.

# NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
# SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"   # server only, never send to the browser


# ============================================================
# APP
# ============================================================
# Browser-facing app origin. OAuth and GitHub App setup redirects return here.
APP_BASE_URL="http://localhost:3000"

# Public HTTPS origin used only for server-to-server GitHub webhooks. GitHub cannot
# POST to localhost. In development, run cloudflared/ngrok/smee and put its origin here.
GITHUB_WEBHOOK_BASE_URL="https://<public-host-or-tunnel>"

# Signs the login session cookie. Anyone holding this can mint a session for any user id,
# so treat it as a signing key. At least 32 random bytes, and startup refuses a shorter
# value or the placeholder below. Generate one: openssl rand -base64 32
AUTH_SECRET="<random-32-bytes-base64>"

# Who may operate BountyDesk, as a comma-separated list of numeric GitHub user ids. Signing
# in with GitHub proves which account you are; this decides whether that account may review
# anything. Ids, not logins: a login can be changed or, once released, taken by someone
# else. Find yours with: curl -s https://api.github.com/users/<login> | jq .id
# Startup fails if this is missing, empty or non-numeric, so there is no accidental
# everyone-is-an-operator state.
REVIEWER_GITHUB_IDS="1234567"


# ============================================================
# GITHUB APP  (GitHub)
# ============================================================
# Create the App at github.com/settings/apps. Least privilege: Metadata read, plus
# Issues read and write. Subscribe to the "Issues" and "Repository" events. GitHub Apps
# receive "Installation" and "Installation repositories" events automatically.
# Handle at minimum:
#   installation: created, deleted, suspend, unsuspend, new_permissions_accepted
#   installation_repositories: added, removed
#   repository: renamed, transferred, archived, unarchived, deleted
# Removed/suspended access must disable intake and delivery immediately.
# Set these in the App config:
#   Callback URL:   ${APP_BASE_URL}/api/auth/github/callback
#   Setup URL:      ${APP_BASE_URL}/api/github/setup
#   Webhook URL:    ${GITHUB_WEBHOOK_BASE_URL}/api/intake/github

GITHUB_APP_ID="<app-id>"
GITHUB_APP_SLUG="<app-slug>"                 # from the App URL; used to build the install link
GITHUB_APP_CLIENT_ID="<client-id>"
GITHUB_APP_CLIENT_SECRET="<client-secret>"

# We own this secret, not the customer. It verifies the X-Hub-Signature-256 header.
GITHUB_APP_WEBHOOK_SECRET="<webhook-secret>"

# The App private key, base64-encoded (avoids newline escaping headaches):
#   base64 -i your-app.private-key.pem | tr -d '\n'
GITHUB_APP_PRIVATE_KEY_BASE64="<base64-of-pem>"


# ============================================================
# Internal worker triggers
# ============================================================
# Bearer secret the /api/internal/jobs/tick and /api/internal/delivery/tick routes require.
# Nothing public may call these; a scheduler (or a local script, for dev and the smoke test)
# presents this as `Authorization: Bearer <value>`. Generate one: openssl rand -base64 32
WORKER_INTERNAL_SECRET="<random-32-bytes-base64>"


# ============================================================
# HARNESS AND MODEL  (TrueForge, OpenAI)
# ============================================================
# Keep TrueForge on loopback. Local mode has no auth. Startup fails closed when this
# URL is non-loopback and TRUEFORGE_API_KEY is blank; any remote endpoint must be an
# authenticated private service or sit behind an authenticated proxy.
TRUEFORGE_URL="http://localhost:8790"
TRUEFORGE_API_KEY=""                    # blank for loopback local mode; set only if fronted by auth
OPENAI_API_KEY="<openai-key>"           # first-class model provider

# Optional: a custom OpenAI-compatible endpoint (for example DeepSeek) as the cost fallback.
# MODEL_BASE_URL="<custom-endpoint>"
# MODEL_API_KEY="<custom-key>"


# ============================================================
# SCOPE-GUARD MCP  (self-hosted)
# ============================================================
# The scope-guard server and the bearer token the harness presents when calling it.
SCOPE_GUARD_URL="http://localhost:8791"
SCOPE_GUARD_TOKEN="<bearer>"


# ============================================================
# SANDBOX  (Daytona)
# ============================================================
DAYTONA_API_KEY="<daytona-key>"

# Daytona's immutable provider snapshot ID (not a mutable display name). The planned demo
# source is Vaibhav91one/juice-shop at commit
# 1867b926c5f50e4e692dc9c8f61821413cebe0cd, the v17.3.0 tag. Source equivalence does not prove
# image provenance. Both values stay placeholders until that commit is built and verified.
DAYTONA_TARGET_SNAPSHOT_ID="<immutable-daytona-snapshot-id>"

# Expected linux/amd64 digest of the generated connected-fork image. The previously recorded
# sha256:123acb... value belongs to bkimminich/juice-shop:v17.3.0 and must not be used as proof
# that the runtime artifact came from the connected fork.
#
# The 2026-08-27 provisioning spike found no resolved-digest field anywhere in the Daytona API:
# a snapshot reports imageName and ref, a sandbox reports neither, and an unprivileged container
# cannot read the manifest digest the host runtime used. So this value is what the build
# recorded, the snapshot is created from a digest-pinned image@sha256 reference, and
# provisioning compares the snapshot's imageName against that reference exactly. A build marker
# checked inside the running target proves the artifact came from our build; that the manifest
# digest matched stays residual trust in the provider.
DAYTONA_TARGET_IMAGE_DIGEST="<sha256-of-connected-fork-build>"


# ============================================================
# SANDBOX LIMITS AND EGRESS  (planned, Q20)
# ============================================================
# None of this is read by code yet. The names are listed so the shape of the contract is
# agreed before the sandbox work starts, not invented under time pressure afterwards.
#
#   Build sandbox      untrusted; runs the customer's code; narrow dependency egress only
#   Reproduction       no external egress at all; only the PoC-to-target path
#
# CPU, memory and disk are not on this list any more. Daytona refuses a create that carries
# resources alongside a snapshot ("Cannot specify Sandbox resources when using a snapshot"),
# so a run cannot ask for limits: they are fixed when the snapshot is built. lib/sandbox
# reads the snapshot and refuses a mismatch instead, because recording a cap that was never
# applied would put a false claim in the evidence packet.
#
# Planned categories, deliberately without values until the numbers are chosen:
#   build and reproduction wall-clock and process-count limits (enforced by us, not by Daytona)
#   the CPU, memory and disk each snapshot must declare, asserted at provisioning time
#   build dependency egress allowlist (the hosts a build may reach, and nothing else)
#   reproduction egress deny, which provisioning refuses to start without
#   intake upload limits: max bytes, max attachment count, max archive depth and expansion


# ============================================================
# INTAKE CHANNELS BEYOND GITHUB  (planned, Q21)
# ============================================================
# Email and file upload are independent channels: neither needs a GitHub connection to create
# and triage a report. No route exists yet and no provider has been chosen, so no vendor name
# or secret is invented here. When the provider is picked, this block gains its webhook
# authentication settings; sender identity is never target authorisation.
