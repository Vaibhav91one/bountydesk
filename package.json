{
  "name": "bounty-desk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:drift": "drizzle-kit generate && git diff --quiet --exit-code drizzle",
    "seed:target": "node --env-file-if-exists=.env.local --import tsx scripts/seed-target.ts",
    "quarantine:stale-target": "node --env-file-if-exists=.env.local --import tsx scripts/quarantine-stale-target.ts",
    "spike:daytona": "node --env-file-if-exists=.env.local --import tsx scripts/spike-daytona.ts",
    "test": "node --env-file-if-exists=.env.local --import tsx --test \"lib/**/*.test.ts\""
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "developer-icons": "^7.1.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
