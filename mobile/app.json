{
  "expo": {
    "name": "BountyDesk",
    "slug": "bountydesk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bountydesk",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "dev.bountydesk.mobile",
      "icon": "./assets/images/icon.png",
      "associatedDomains": [
        "applinks:app.bountydesk.vaibhav.quest"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "package": "dev.bountydesk.mobile",
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.bountydesk.vaibhav.quest",
              "pathPrefix": "/reports"
            },
            {
              "scheme": "https",
              "host": "app.bountydesk.vaibhav.quest",
              "pathPrefix": "/inbox"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      "@clerk/expo",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "BountyDesk uses Face ID to confirm that you approve a verdict."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "725b2ab9-cb04-4843-9a6e-adae8b953f7a"
      }
    },
    "owner": "vaibhav2003"
  }
}
